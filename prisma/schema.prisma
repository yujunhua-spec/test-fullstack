// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique // 每个邮箱只能注册一次
  password String // 存的是 bcrypt 哈希，绝不存明文
  notes    Note[] // 关系：一个用户有多条留言（这是关系的"一"端）
}

// 一张表 = 一个 model。字段类型是 Prisma 自己的类型，会映射到数据库列。
model Note {
  id        Int      @id @default(autoincrement()) // 主键，自增
  text      String
  createdAt DateTime @default(now()) // 新建时自动填当前时间
  author    User     @relation(fields: [authorId], references: [id]) // 关系：这条留言属于哪个用户
  authorId  Int // 外键：存作者的 User.id
}
